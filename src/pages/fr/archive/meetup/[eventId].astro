---
import MeetupArchive from '../../../../components/pages/meetup-archive/meetup-archive.astro';
import { readArchive } from '../../../../lib/meetup-archive.mjs';
export function getStaticPaths() {
  return readArchive().events.filter((event) => event.source === 'meetup').map((event) => ({ params: { eventId: event.id } }));
}
---
<MeetupArchive lang="fr" source="meetup" eventId={Astro.params.eventId} />
